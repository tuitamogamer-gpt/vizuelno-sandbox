# Server-only. Never use NEXT_PUBLIC_ for these values.
ACCESS_CODE=
SESSION_SECRET=
# Optional: server-only Pika API Club key. Empty means generation is disabled.
PIKA_API_KEY=
# Reject quotes above this amount per single image (USD).
PIKA_MAX_IMAGE_USD=0.25

# Optional individual Google accounts; all of these stay on the server.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production origin, without a trailing slash; use http://localhost:3000 locally.
BETTER_AUTH_URL=https://vizuelno-komuniciranje.vercel.app
# Recommended separate random secret, at least 32 characters. Falls back to SESSION_SECRET.
BETTER_AUTH_SECRET=
# Comma-separated verified Google emails with the instructor role.
INSTRUCTOR_EMAILS=
