[
  {
    "api_id": "openai/gpt-image-2.5-sunburst/text-to-image",
    "call": {
      "method": "POST",
      "path": "/v1/media/openai/gpt-image-2.5-sunburst/text-to-image"
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "description": "Text prompt describing the image to generate.",
          "maxLength": 32000,
          "title": "Prompt",
          "type": "string"
        },
        "num_images": {
          "default": 1,
          "description": "Number of images to generate.",
          "maximum": 10,
          "minimum": 1,
          "title": "Num Images",
          "type": "integer"
        },
        "aspect_ratio": {
          "default": "1:1",
          "description": "Output aspect ratio. Ignored when 'size' is set.",
          "enum": [
            "1:1",
            "2:3",
            "3:2",
            "3:4",
            "4:3",
            "4:5",
            "5:4",
            "9:16",
            "16:9",
            "21:9"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "output_format": {
          "default": "png",
          "description": "Image file format of the output.",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ],
          "title": "Output Format",
          "type": "string"
        },
        "resolution": {
          "default": "1K",
          "description": "Output resolution.",
          "enum": [
            "1K",
            "2K",
            "4K"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "background": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "opaque",
                "transparent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Background of the output. 'transparent' needs a png or webp output_format.",
          "title": "Background"
        },
        "size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit output size as 'WxH' (e.g. '1024x1024'), or 'auto' to let the provider choose. Overrides aspect_ratio and resolution.",
          "title": "Size"
        },
        "quality": {
          "default": "medium",
          "description": "Rendering quality of the output.",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "title": "Quality",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "GPTImage25TextToImageRequest",
      "type": "object"
    }
  },
